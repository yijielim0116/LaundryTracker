<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- NoActionBar because I put my own Toolbar in the layouts
         Bridge = a Material theme that still keeps the normal AppCompat buttons/radio buttons,
         I only switched so the Material NavigationView (the drawer) works -->
    <style name="Theme.LaundryTracker" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <!-- teal for the toolbar, and the radio buttons / buttons use it too -->
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorPrimaryDark">@color/teal_700</item>
        <item name="colorAccent">@color/teal_700</item>
        <!-- Material uses colorSecondary where AppCompat used colorAccent -->
        <item name="colorSecondary">@color/teal_700</item>
    </style>

    <!-- splash theme, teal background so there's no white flash before my layout shows -->
    <style name="Theme.LaundryTracker.Splash">
        <item name="android:windowBackground">@color/teal_700</item>
    </style>
</resources>
