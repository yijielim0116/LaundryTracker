<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight = light normally, dark when the phone (or my Dark mode setting) is in dark mode
         NoActionBar because I put my own Toolbar in the layouts
         full Material theme now, so buttons, radio buttons and text fields are Material ones -->
    <style name="Theme.LaundryTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- teal for buttons, radio buttons and the ticked drawer item -->
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorPrimaryVariant">@color/toolbar</item>
        <!-- otherwise screens without edge-to-edge (the add/edit form) get Material's default purple status bar -->
        <item name="android:statusBarColor">@color/toolbar</item>
        <!-- slide between screens (style is in values/themes.xml) -->
        <item name="android:windowAnimationStyle">@style/ScreenSlideAnimations</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
    </style>

    <!-- the animations every screen uses when it opens and closes (res/anim)
         set once here in the theme, so I don't need to add code to every startActivity -->
    <style name="ScreenSlideAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- splash theme, teal background so there's no white flash before my layout shows -->
    <style name="Theme.LaundryTracker.Splash">
        <item name="android:windowBackground">@color/teal_700</item>
    </style>
</resources>
