<?xml version="1.0" encoding="utf-8"?>
<!-- the items in the navigation drawer -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the main screens, "single" means only one of them is highlighted (the one I'm on) -->
    <group
        android:id="@+id/nav_group_screens"
        android:checkableBehavior="single">

        <item
            android:id="@+id/nav_home"
            android:icon="@drawable/ic_nav_home"
            android:title="Home" />

        <item
            android:id="@+id/nav_machines"
            android:icon="@drawable/ic_nav_machines"
            android:title="Machines" />

        <item
            android:id="@+id/nav_map"
            android:icon="@drawable/ic_nav_map"
            android:title="Map" />
    </group>

    <!-- a different group so the drawer draws a line above these -->
    <group android:id="@+id/nav_group_actions">

        <item
            android:id="@+id/nav_add_machine"
            android:icon="@drawable/ic_nav_add"
            android:title="Add machine" />

        <item
            android:id="@+id/nav_dark_mode"
            android:icon="@drawable/ic_nav_dark_mode"
            android:title="Dark mode" />

        <item
            android:id="@+id/nav_about"
            android:icon="@drawable/ic_nav_about"
            android:title="About" />

        <item
            android:id="@+id/nav_logout"
            android:icon="@drawable/ic_nav_logout"
            android:title="Log out" />
    </group>
</menu>
