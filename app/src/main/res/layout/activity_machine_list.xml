<?xml version="1.0" encoding="utf-8"?>
<!-- DrawerLayout = the machine list with the navigation drawer that slides in over it from the left -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.machinelist.MachineListView">

    <!-- first child = the screen itself -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- toolbar at the top with the ☰ button for the drawer and the menu -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/toolbar"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        <!-- FrameLayout so the round Add button can float on top of the list -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- everything under the toolbar, padding is here so the toolbar can go edge to edge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp">

                <!-- search box, the list updates while typing -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Search by name or location">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/searchInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- drop-down to only show machines with a certain status, options are in strings.xml -->
                <Spinner
                    android:id="@+id/statusFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:entries="@array/status_filter_options" />

                <!-- shows when there's nothing in the list (no machines, or nothing matches) -->
                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <!-- the machine list, MachineAdapter makes a row (item_machine.xml) for each machine
                     RecyclerView scrolls by itself so it doesn't need a ScrollView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/machinesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- round + button in the corner, replaces the ADD on the toolbar
                 (the list has extra space at the bottom so the last card isn't hidden behind it) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/addMachineFab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="24dp"
                android:contentDescription="Add machine"
                app:srcCompat="@drawable/ic_nav_add" />
        </FrameLayout>
    </LinearLayout>

    <!-- second child = the drawer, same one as on the home screen -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
