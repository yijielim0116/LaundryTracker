<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- the camera is nice to have, the app still works on phones without one (Select Image) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- MainApp sets up the JSON store when the app starts -->
    <application
        android:name=".main.MainApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LaundryTracker">
        <!-- splash is the LAUNCHER now so it's the first screen when the app opens -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.LaundryTracker.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.LaundryTracker"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.LaundryTracker"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.LaundryTracker"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.MachineListActivity"
            android:exported="false"
            android:label="Machines"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/Theme.LaundryTracker"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.AddEditActivity"
            android:exported="false"
            android:label="Add Machine"
            android:parentActivityName=".activities.MachineListActivity"
            android:theme="@style/Theme.LaundryTracker"
            android:windowSoftInputMode="adjustResize" />

        <!-- lets the camera app save a photo into my app's private images folder -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>